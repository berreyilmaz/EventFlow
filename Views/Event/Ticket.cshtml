@model EventFlow.Models.Registration

@{
    ViewData["Title"] = "Event Ticket";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary text-white text-center py-4">

                    <h2 class="mb-1">
                        <i class="bi bi-ticket-perforated-fill"></i>
                        Event Ticket
                    </h2>

                    <p class="mb-0">
                        Your registration has been confirmed.
                    </p>

                </div>

                <div class="card-body p-5">

                    <div class="row">

                        <div class="col-md-6">

                            <h5 class="text-primary mb-3">
                                Event Information
                            </h5>

                            <p>
                                <strong>Title</strong><br />
                                @Model.Event.Title
                            </p>

                            <p>
                                <strong>Category</strong><br />
                                @Model.Event.Category.Name
                            </p>

                            <p>
                                <strong>Location</strong><br />
                                @Model.Event.Location
                            </p>

                            <p>
                                <strong>Start Date</strong><br />
                                @Model.Event.StartDate.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <p>
                                <strong>End Date</strong><br />
                                @Model.Event.EndDate.ToString("dd MMM yyyy HH:mm")
                            </p>

                        </div>

                        <div class="col-md-6">

                            <h5 class="text-success mb-3">
                                Participant
                            </h5>

                            <p>
                                <strong>Name</strong><br />
                                @Model.User.FullName
                            </p>

                            <p>
                                <strong>Email</strong><br />
                                @Model.User.Email
                            </p>

                            <p>
                                <strong>Organizer</strong><br />
                                @Model.Event.Organizer.FullName
                            </p>

                            <p>
                                <strong>Registration Date</strong><br />
                                @Model.RegisteredAt.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Ticket Number</strong><br />
                                EVT-@Model.Id.ToString("D6")
                            </p>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="text-center">

                        <div class="border rounded p-4 d-inline-block">

                            <img src="data:image/png;base64,@ViewBag.QrCode"
                                class="img-fluid"
                                style="max-width:220px;" />

                            <p class="text-muted mt-3">
                                Scan this QR code to access your digital ticket.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="card-footer text-center">

                    <a asp-action="MyRegistrations"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back to My Registrations

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>