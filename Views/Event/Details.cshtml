@model EventFlow.Models.Event

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Event Details";
}


<div class="container mt-4">

    <h2 class="mb-4">@Model.Title</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row">

        <!-- Sol Taraf -->
        <div class="col-lg-7">

            <table class="table table-bordered">

                <tr>
                    <th>Kategori</th>
                    <td>@Model.Category.Name</td>
                </tr>

                <tr>
                    <th>Konum</th>
                    <td>@Model.Location</td>
                </tr>

                <tr>
                    <th>Başlangıç</th>
                    <td>@Model.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>

                <tr>
                    <th>Bitiş</th>
                    <td>@Model.EndDate.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>

                <tr>
                    <th>Kapasite</th>
                    <td>@Model.Capacity</td>
                </tr>

                <tr>
                    <th>Açıklama</th>
                    <td>@Model.Description</td>
                </tr>

                <tr>
                    <th>Katılımcı</th>
                    <td>
                        @Model.Registrations.Count / @Model.Capacity
                    </td>
                </tr>

                <tr>
                    <th>Kalan Kontenjan</th>
                    <td>
                        @(Model.Capacity - Model.Registrations.Count)
                    </td>
                </tr>

            </table>

        </div>

        <!-- Sağ Taraf -->
        <div class="col-lg-5 text-center">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="~/uploads/events/@Model.ImageUrl"
                     class="img-fluid rounded shadow"
                     style="max-height:450px; object-fit:cover;" />
            }
            else
            {
                <div class="border rounded p-5 text-muted">
                    Image not found.
                </div>
            }

        </div>

        @{
            var currentUserId =
                User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            var joined =
                Model.Registrations.Any(r => r.UserId == currentUserId);
        }

        <div class="mt-4 d-flex gap-2">

        @if (joined)
        {
            <form asp-action="Leave" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                    name="id"
                    value="@Model.Id" />

                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i>
                    Cancel Registration
                </button>
            </form>

            <a asp-action="Ticket"
            asp-route-registrationId="@ViewBag.UserRegistrationId"
            class="btn btn-primary">

                <i class="bi bi-ticket-perforated-fill"></i>
                View Ticket

            </a>
        }
        else
        {
            <form asp-action="Join" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                    name="id"
                    value="@Model.Id" />

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-calendar-check"></i>
                    Join Event
                </button>
            </form>
        }

    </div>

     

        <hr />

        <h4>Attendees</h4>

        @if (Model.Registrations.Any())
        {
            <ul class="list-group">

                @foreach (var registration in Model.Registrations)
                {
                    <li class="list-group-item">

                        @registration.User.FullName

                    </li>
                }

            </ul>
        }
        else
        {
            <div class="alert alert-info">

                No attendees yet.

            </div>
        }

    </div>

</div>