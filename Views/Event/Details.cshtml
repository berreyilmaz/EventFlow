@model EventFlow.Models.Event

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Etkinlik Detayı";
}


<div class="container mt-4">

    <h2 class="mb-4">@Model.Title</h2>

    <div class="row">

        <!-- Sol Taraf -->
        <div class="col-lg-7">

            <table class="table table-bordered">

                <tr>
                    <th>Kategori</th>
                    <td>@Model.Category.Name</td>
                </tr>

                <tr>
                    <th>Konum</th>
                    <td>@Model.Location</td>
                </tr>

                <tr>
                    <th>Başlangıç</th>
                    <td>@Model.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>

                <tr>
                    <th>Bitiş</th>
                    <td>@Model.EndDate.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>

                <tr>
                    <th>Kapasite</th>
                    <td>@Model.Capacity</td>
                </tr>

                <tr>
                    <th>Açıklama</th>
                    <td>@Model.Description</td>
                </tr>

            </table>

        </div>

        <!-- Sağ Taraf -->
        <div class="col-lg-5 text-center">

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="~/uploads/events/@Model.ImageUrl"
                     class="img-fluid rounded shadow"
                     style="max-height:450px; object-fit:cover;" />
            }
            else
            {
                <div class="border rounded p-5 text-muted">
                    Resim bulunamadı.
                </div>
            }

        </div>

    </div>

</div>