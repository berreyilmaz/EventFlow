@model EventFlow.Models.Event

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Etkinliği Sil";
}

<h2>Etkinliği Sil</h2>

<div class="alert alert-danger">
    Bu etkinliği silmek istediğinize emin misiniz?
</div>

<dl class="row">
    <dt class="col-sm-3">Başlık</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Kategori</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Konum</dt>
    <dd class="col-sm-9">@Model.Location</dd>
</dl>

<form asp-action="Delete" method="post">

    <input asp-for="Id" type="hidden" />

    <button class="btn btn-danger">
        Evet, Sil
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Vazgeç
    </a>

</form>