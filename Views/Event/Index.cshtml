@model IEnumerable<EventFlow.Models.Event>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Etkinlikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>🎉 Etkinlikler</h2>

    <a asp-action="Create"
       class="btn btn-primary">
        + Yeni Etkinlik
    </a>

</div>

<div class="row">

@foreach (var item in Model)
{
    <div class="col-lg-4 col-md-6 mb-4">

        <div class="card shadow h-100 border-0">

            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                <img src="~/uploads/events/@item.ImageUrl"
                     class="card-img-top"
                     style="height:220px; object-fit:cover;" />
            }
            else
            {
                <img src="https://placehold.co/600x400?text=No+Image"
                     class="card-img-top"
                     style="height:220px; object-fit:cover;" />
            }

            <div class="card-body">

                <h5 class="card-title fw-bold">
                    @item.Title
                </h5>

                <hr />

                <p class="mb-2">
                    📂 <strong>Kategori:</strong>
                    @item.Category.Name
                </p>

                <p class="mb-2">
                    📍 <strong>Konum:</strong>
                    @item.Location
                </p>

                <p class="mb-2">
                    👥 <strong>Kontenjan:</strong>
                    @item.Capacity
                </p>

                <p class="mb-0">
                    👤 <strong>Organizatör:</strong>
                    @item.Organizer.FullName
                </p>

            </div>

            <div class="card-footer bg-white border-0">

                <div class="d-grid gap-2">

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info">
                        👁️ Detay
                    </a>

                    <div class="row">

                        <div class="col-6">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning w-100">
                                ✏️ Düzenle
                            </a>

                        </div>

                        <div class="col-6">

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger w-100">
                                🗑️ Sil
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
}

</div>