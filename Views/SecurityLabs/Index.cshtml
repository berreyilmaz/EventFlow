@model IEnumerable<EventFlow.ViewModels.Security.SecurityLabViewModel>

@{
    ViewData["Title"] = "Security Labs";

    var totalLabs = Model.Count();
    var completedLabs = Model.Count(x => x.Completed);
    var progress = totalLabs == 0 ? 0 : completedLabs * 100 / totalLabs;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                <i class="bi bi-shield-lock-fill text-success"></i>
                Security Center
            </h2>

            <p class="text-muted mb-0">
                EventFlow Security Dashboard
            </p>

        </div>

        <span class="badge bg-success fs-6">
            @completedLabs / @totalLabs Labs Completed
        </span>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="bi bi-list-check fs-1 text-primary"></i>

                    <h2 class="mt-2">@totalLabs</h2>

                    <small class="text-muted">
                        Total Labs
                    </small>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="bi bi-check-circle-fill fs-1 text-success"></i>

                    <h2 class="mt-2">@completedLabs</h2>

                    <small class="text-muted">
                        Completed
                    </small>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="bi bi-bar-chart-fill fs-1 text-warning"></i>

                    <h2 class="mt-2">@progress%</h2>

                    <small class="text-muted">
                        Security Score
                    </small>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body text-center">

                    <i class="bi bi-cpu-fill fs-1 text-danger"></i>

                    <h5 class="mt-3">
                        ASP.NET Core
                    </h5>

                    <small class="text-muted">
                        Framework
                    </small>

                </div>

            </div>

        </div>

    </div>

    <div class="progress mb-5" style="height:28px;">

        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
             style="width:@progress%">

            @progress%

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white">

            <i class="bi bi-shield-check"></i>

            Implemented Security Labs

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                <tr>

                    <th>#</th>

                    <th>Feature</th>

                    <th>Category</th>

                    <th>Status</th>

                    <th class="text-center">Action</th>

                </tr>

                </thead>

                <tbody>

                @foreach (var lab in Model)
                {
                    <tr>

                        <td>@lab.Id</td>

                        <td>

                            <strong>@lab.Title</strong>

                        </td>

                        <td>

                            <span class="badge bg-secondary">

                                @lab.Category

                            </span>

                        </td>

                        <td>

                            @if (lab.Completed)
                            {
                                <span class="badge bg-success">

                                    Completed

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">

                                    Pending

                                </span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@lab.Id"
                               class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-eye"></i>

                                Details

                            </a>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

    <div class="card mt-4 shadow-sm border-0">

        <div class="card-header bg-success text-white">

            <i class="bi bi-check2-circle"></i>

            Security Summary

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <ul class="list-unstyled">

                        <li>✅ Authentication</li>
                        <li>✅ Authorization</li>
                        <li>✅ Input Validation</li>
                        <li>✅ SQL Injection Prevention</li>

                    </ul>

                </div>

                <div class="col-md-4">

                    <ul class="list-unstyled">

                        <li>✅ XSS Protection</li>
                        <li>✅ CSRF Protection</li>
                        <li>✅ Rate Limiting</li>
                        <li>✅ Security Headers</li>

                    </ul>

                </div>

                <div class="col-md-4">

                    <ul class="list-unstyled">

                        <li>✅ Audit Logging</li>
                        <li>✅ Exception Logging</li>
                        <li>✅ Secure Cookies</li>
                        <li>✅ Data Protection</li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>