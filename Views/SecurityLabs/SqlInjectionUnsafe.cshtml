@model IEnumerable<EventFlow.Models.Event>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "SQL Injection Unsafe";
}

<h2>⚠️ SQL Injection Demo (Unsafe)</h2>

<div class="alert alert-danger">
    Bu sayfa eğitim amaçlı bilerek güvensiz SQL sorgusu kullanmaktadır.
</div>

<form asp-action="SqlInjectionUnsafe"
      method="get">

    <input class="form-control"
           name="search"
           value="@ViewBag.Search"
           placeholder="Search title..." />

    <button class="btn btn-danger mt-3">
        Search
    </button>

</form>

<hr/>

@if (Model.Any())
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
            </tr>
        }

        </tbody>

    </table>
}
else
{
    <div class="alert alert-warning">
        No records found.
    </div>
}