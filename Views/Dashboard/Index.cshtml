@model EventFlow.ViewModels.Dashboard.DashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4">
        Dashboard
    </h2>

    <div class="row g-4">

        <!-- Kategoriler -->
        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-tags fs-1 text-primary"></i>

                    <h5 class="mt-3">
                        Kategoriler
                    </h5>

                    <h2 class="fw-bold">
                        @Model.TotalCategories
                    </h2>

                </div>

            </div>

        </div>

        <!-- Etkinlikler -->
        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-calendar-event fs-1 text-success"></i>

                    <h5 class="mt-3">
                        Etkinlikler
                    </h5>

                    <h2 class="fw-bold">
                        @Model.TotalEvents
                    </h2>

                </div>

            </div>

        </div>

        <!-- Kullanıcılar -->
        <div class="col-md-4">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center">

                    <i class="bi bi-people fs-1 text-danger"></i>

                    <h5 class="mt-3">
                        Kullanıcılar
                    </h5>

                    <h2 class="fw-bold">
                        @Model.TotalUsers
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-5">

        <div class="col-12">

            <div class="card shadow border-0">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        <i class="bi bi-clock-history me-2"></i>

                        Son Eklenen Etkinlikler

                    </h5>

                </div>

                <div class="card-body">

                    @if (Model.RecentEvents.Any())
                    {
                        <table class="table table-hover align-middle">

                            <thead>

                                <tr>

                                    <th>Başlık</th>

                                    <th>Konum</th>

                                    <th>Başlangıç</th>

                                    <th></th>

                                </tr>

                            </thead>

                            <tbody>

                            @foreach (var item in Model.RecentEvents)
                            {
                                <tr>

                                    <td>@item.Title</td>

                                    <td>@item.Location</td>

                                    <td>@item.StartDate.ToString("dd.MM.yyyy HH:mm")</td>

                                    <td class="text-end">

                                        <a asp-controller="Event"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            Detay

                                        </a>

                                    </td>

                                </tr>
                            }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">

                            Henüz oluşturulmuş etkinlik bulunmuyor.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>