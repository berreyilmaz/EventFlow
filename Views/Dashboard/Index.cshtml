@model EventFlow.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">
    <i class="bi bi-speedometer2"></i>
    Dashboard
</h2>

<div class="row g-4">

    <!-- Total Users -->
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center">

                <i class="bi bi-people-fill text-primary display-5"></i>

                <h6 class="mt-3 text-muted">
                    Total Users
                </h6>

                <h2 class="fw-bold">
                    @Model.TotalUsers
                </h2>

            </div>
        </div>
    </div>

    <!-- Total Events -->
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center">

                <i class="bi bi-calendar-event text-success display-5"></i>

                <h6 class="mt-3 text-muted">
                    Active Events
                </h6>

                <h2 class="fw-bold">
                    @Model.TotalEvents
                </h2>

            </div>
        </div>
    </div>

    <!-- Registrations -->
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center">

                <i class="bi bi-ticket-perforated text-info display-5"></i>

                <h6 class="mt-3 text-muted">
                    Registrations
                </h6>

                <h2 class="fw-bold">
                    @Model.TotalRegistrations
                </h2>

            </div>
        </div>
    </div>

    <!-- Audit Logs -->
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm border-success h-100">
            <div class="card-body text-center">

                <i class="bi bi-clipboard-data text-success display-5"></i>

                <h6 class="mt-3 text-muted">
                    Audit Logs
                </h6>

                <h2 class="fw-bold text-success">
                    @Model.TotalAuditLogs
                </h2>

            </div>
        </div>
    </div>

    <!-- Unauthorized -->
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm border-warning h-100">
            <div class="card-body text-center">

                <i class="bi bi-shield-exclamation text-warning display-5"></i>

                <h6 class="mt-3 text-muted">
                    Unauthorized Access
                </h6>

                <h2 class="fw-bold text-warning">
                    @Model.UnauthorizedAttempts
                </h2>

            </div>
        </div>
    </div>

    <!-- Exception Logs -->
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm border-danger h-100">
            <div class="card-body text-center">

                <i class="bi bi-bug-fill text-danger display-5"></i>

                <h6 class="mt-3 text-muted">
                    Exception Logs
                </h6>

                <h2 class="fw-bold text-danger">
                    @Model.TotalExceptions
                </h2>

            </div>
        </div>
    </div>

</div>

<hr class="my-5" />

<div class="row">

    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">

                <i class="bi bi-shield-lock"></i>

                Security Overview

            </div>

            <div class="card-body">

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        ✔ Audit Logging Enabled
                    </li>

                    <li class="list-group-item">
                        ✔ Authorization Logging Enabled
                    </li>

                    <li class="list-group-item">
                        ✔ Exception Logging Enabled
                    </li>

                    <li class="list-group-item">
                        ✔ Rate Limiting Enabled
                    </li>

                    <li class="list-group-item">
                        ✔ CSP Enabled
                    </li>

                    <li class="list-group-item">
                        ✔ Security Headers Enabled
                    </li>

                </ul>

            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">

                <i class="bi bi-info-circle"></i>

                Project Status

            </div>

            <div class="card-body">

                <p>
                    EventFlow is protected with multiple security layers including authentication,
                    authorization, audit logging, authorization logging, exception logging,
                    file upload validation, brute force protection, rate limiting,
                    security headers and Content Security Policy (CSP).
                </p>

                <div class="progress mt-4" style="height:25px;">

                    <div class="progress-bar bg-success"
                         role="progressbar"
                         style="width:100%">

                        Security Features Completed

                    </div>

                </div>

            </div>

        </div>

    </div>

    <footer class="text-center text-muted mt-5 mb-3">

        <hr>

        <small>

            © 2026 EventFlow

            •

            ASP.NET Core MVC

            •

            Developed by Berre Yılmaz

        </small>

    </footer>
</div>