@model IEnumerable<EventFlow.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<h2 class="mb-4">Audit Logs</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>User</th>
            <th>Action</th>
            <th>Description</th>
            <th>IP Address</th>
        </tr>
    </thead>

    <tbody>

@foreach (var log in Model)
{
        <tr>
            <td>@log.CreatedAt.ToLocalTime()</td>
            <td>@log.UserName</td>
            <td>@log.Action</td>
            <td>@log.Description</td>
            <td>@log.IpAddress</td>
        </tr>
}

    </tbody>
</table>